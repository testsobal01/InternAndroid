<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/orenge"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="50dp">

        </LinearLayout>

        <TextView
            android:id="@+id/Top_text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HIGH and ROW"
            android:gravity="center"
            android:textSize="45sp"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/Top_text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GAME"
            android:gravity="center"
            android:textSize="50sp"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/Top_text3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/Top_text3"
            android:textColor="@color/black"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/Top_text4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/Top_text4"
            android:textColor="@color/black"
            android:textSize="30sp" />



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="130dp">

        </LinearLayout>

        <Button
            android:id="@+id/button_top"
            android:layout_width="280dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/kara"
            app:backgroundTint="@null"
            android:text="@string/Top" />
    </LinearLayout>

</LinearLayout>